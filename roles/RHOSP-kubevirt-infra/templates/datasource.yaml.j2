---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataSource
metadata:
  name: rhel-image-{{ RHOSP_version_supported[RHOSP_version].rhel_image.name | regex_replace('\\.qcow2$', '') }}
  namespace: {{ KubeVirtNamespace }}
spec:
  source:
    http:
      url: {{ CustomRhelImage }}
  contentType: kubevirt
