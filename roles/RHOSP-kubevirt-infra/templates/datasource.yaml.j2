---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataSource
metadata:
  name: rhel-image-{{ RHOSP_version_supported[RHOSP_version].rhel_image.name | regex_replace('\\.qcow2$', '') | regex_replace('[._]', '-') | lower }}
  namespace: {{ KubeVirtNamespace }}
spec:
  source:
    pvc:
      name: rhel-image-{{ RHOSP_version_supported[RHOSP_version].rhel_image.name | regex_replace('\\.qcow2$', '') | regex_replace('[._]', '-') | lower }}
      namespace: {{ KubeVirtNamespace }}
