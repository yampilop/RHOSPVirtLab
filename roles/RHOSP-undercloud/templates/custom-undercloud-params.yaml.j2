parameter_defaults:
  AdminPassword: "{{ OvercloudAdminPassword }}"
  AdminEmail: "{{ OvercloudAdminEmail }}"

  # Snmp definitions
  SnmpdReadonlyUserPassword: {{ SnmpdReadonlyUserPassword }}

{% if UndercloudExtraFirewallRules is defined and UndercloudExtraFirewallRules %}
{% if RHOSP_version >= 17.1 %}
  ExtraFirewallRules:
{% for key in UndercloudExtraFirewallRules.keys() %}
    '{{ key }}': {{ UndercloudExtraFirewallRules[key] | to_yaml }}
{%- endfor %}
{% else %}
  ExtraConfig:
    tripleo::firewall::firewall_rules:
{% for key in UndercloudExtraFirewallRules.keys() %}
      '{{ key }}': {{ UndercloudExtraFirewallRules[key] | to_yaml }}
{%- endfor %}
{% endif %}
{% endif %}
