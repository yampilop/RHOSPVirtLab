heat_template_version: {{ RHOSP_version_supported[RHOSP_version].heat_template_version }}
description: >
  Software Config to drive os-net-config to configure VLANs for the {{ item.name }} role.
parameters:
  ControlPlaneIp:
    default: ''
    description: IP address/subnet on the ctlplane network
    type: string
  ControlPlaneSubnetCidr:
    default: ''
    description: >
      The subnet CIDR of the control plane network. (The parameter is
      automatically resolved from the ctlplane subnet's cidr attribute.)
    type: string
  ControlPlaneDefaultRoute:
    default: ''
    description: The default route of the control plane network. (The parameter
      is automatically resolved from the ctlplane subnet's gateway_ip attribute.)
    type: string
  ControlPlaneStaticRoutes:
    default: []
    description: >
      Routes for the ctlplane network traffic.
      JSON route e.g. [{'destination':'10.0.0.0/16', 'nexthop':'10.0.0.1'}]
      Unless the default is changed, the parameter is automatically resolved
      from the subnet host_routes attribute.
    type: json
  ControlPlaneMtu:
    default: 1500
    description: The maximum transmission unit (MTU) size(in bytes) that is
      guaranteed to pass through the data path of the segments in the network.
      (The parameter is automatically resolved from the ctlplane network's mtu attribute.)
    type: number

{% for network in roles_networks[item.name] %}
  {{ network }}IpSubnet:
    default: ''
    description: IP address/subnet on the {{ network }} network
    type: string
  {{ network }}NetworkVlanID:
    default: {{ (leaf.networks | selectattr('name', 'equalto', network) | first).subnet.vlan | default(1) }}
    description: Vlan ID for the {{ network }} network traffic.
    type: number
  {{ network }}Mtu:
    default: 1500
    description: The maximum transmission unit (MTU) size(in bytes) that is
      guaranteed to pass through the data path of the segments in the
      {{ network }} network.
    type: number
  {{ network }}InterfaceDefaultRoute:
    default: ''
    description: default route for the {{ network }} network
    type: string
  {{ network }}InterfaceRoutes:
    default: []
    description: >
      Routes for the {{ network }} network traffic.
      JSON route e.g. [{'destination':'10.0.0.0/16', 'nexthop':'10.0.0.1'}]
      Unless the default is changed, the parameter is automatically resolved
      from the subnet host_routes attribute.
    type: json

{% endfor %}

  DnsServers: # Override this via parameter_defaults
    default: []
    description: >
      DNS servers to use for the Overcloud (2 max for some implementations).
      If not set the nameservers configured in the ctlplane subnet's
      dns_nameservers attribute will be used.
    type: comma_delimited_list
  DnsSearchDomains: # Override this via parameter_defaults
    default: []
    description: A list of DNS search domains to be added (in order) to resolv.conf.
    type: comma_delimited_list

resources:

  MinViableMtu:
    # This resource resolves the minimum viable MTU for interfaces, bonds and
    # bridges that carry multiple VLANs. Each VLAN may have different MTU. The
    # bridge, bond or interface must have an MTU to allow the VLAN with the
    # largest MTU.
    type: OS::Heat::Value
    properties:
      type: number
      value:
        yaql:
          expression: $.data.max()
          data:
            - {get_param: ControlPlaneMtu}
{% for network in roles_networks[item.name] if network != 'External' %}
            - {get_param: {{ network }}Mtu}
{% endfor %}

  OsNetConfigImpl:
    type: OS::Heat::SoftwareConfig
    properties:
      group: script
      config:
        str_replace:
          template:
            get_file: /usr/share/openstack-tripleo-heat-templates/network/scripts/run-os-net-config.sh
          params:
            $network_config:
              network_config:
{#- The bridges for this role come from RoleBridgeMappings[<role>], falling back  #}
{#- to RoleBridgeMappings.Default. Each bridge lists its members (NICs), the      #}
{#- untagged `native` network whose IP sits on the bridge, and the tagged        #}
{#- `vlans`. VLANs and native addresses are filtered to the networks the role    #}
{#- actually carries (roles_networks[<role>]).                                    #}
{%- set role_bridges = RoleBridgeMappings[item.name] | default(RoleBridgeMappings['Default']) %}
{%- for bridge in role_bridges %}
{%- if bridge.type == 'sriov_pf' %}
              - type: sriov_pf
                name: {{ bridge.name }}
                numvfs: {{ bridge.numvfs }}
                promisc: true
                use_dhcp: false
                nm_controlled: true
                mtu:
                  get_param: ExternalMtu
                defroute: false
{%- if bridge.link_mode is defined %}
                link_mode: {{ bridge.link_mode }}
{%- endif %}
{%- else %}
{%- if bridge.native is defined and bridge.native == 'CtlPlane' %}
{%- set bridge_mtu_line = 'get_attr: [MinViableMtu, value]' %}
{%- elif bridge.native is defined and bridge.native in roles_networks[item.name] %}
{%- set bridge_mtu_line = 'get_param: ' ~ bridge.native ~ 'Mtu' %}
{%- else %}
{%- set bridge_mtu_line = '' %}
{%- endif %}
              - type: {{ bridge.type }}
                name: {{ bridge.name }}
{%- if bridge.native is defined and bridge.native == 'CtlPlane' %}
                mtu:
                  get_attr: [MinViableMtu, value]
                use_dhcp: false
                dns_servers:
                  get_param: DnsServers
                domain:
                  get_param: DnsSearchDomains
                addresses:
                - ip_netmask:
                    list_join:
                    - /
                    - - get_param: ControlPlaneIp
                      - get_param: ControlPlaneSubnetCidr
                routes:
                  list_concat_unique:
                    - get_param: ControlPlaneStaticRoutes
                    - - default: true
                        next_hop:
                          get_param: ControlPlaneDefaultRoute
{%- elif bridge.native is defined and bridge.native in roles_networks[item.name] %}
                mtu:
                  get_param: {{ bridge.native }}Mtu
                use_dhcp: false
                addresses:
                - ip_netmask:
                    get_param: {{ bridge.native }}IpSubnet
                routes:
                  list_concat_unique:
                    - get_param: {{ bridge.native }}InterfaceRoutes
{%- if bridge.native == 'External' %}
                    - - default: true
                        next_hop:
                          get_param: ExternalInterfaceDefaultRoute
{%- endif %}
{%- else %}
                use_dhcp: false
{%- endif %}
{%- if bridge.members is defined %}
                members:
{%- for member in bridge.members %}
{%- if member is string %}
{%- if 'v' in member %}
                - type: sriov_vf
                  device: {{ member.split('v')[0] }}
                  vfid: {{ member.split('v')[1] }}
{%- else %}
                - type: interface
                  name: {{ member }}
{%- endif %}
{%- if bridge_mtu_line %}
                  mtu:
                    {{ bridge_mtu_line }}
{%- endif %}
{%- if loop.first %}
                  # force the MAC address of the bridge to this interface
                  primary: true
{%- endif %}
{%- else %}
                - type: {{ member.type }}
{%- if member.name is defined %}
                  name: {{ member.name }}
{%- endif %}
{%- if member.type == 'ovs_dpdk_bond' %}
                  mtu: {{ member.mtu | default(9000) }}
                  rx_queue: {{ member.rx_queue | default(1) }}
                  ovs_extra:
{%- for p in member.members %}
                    - set Interface {{ p.name }} options:n_rxq_desc=4096
                    - set Interface {{ p.name }} options:n_txq_desc=4096
{%- endfor %}
{%- endif %}
{%- if member.members is defined %}
                  members:
{%- for p in member.members %}
                  - type: {{ p.type }}
                    name: {{ p.name }}
{%- if p.driver is defined %}
                    driver: {{ p.driver }}
{%- endif %}
{%- if p.members is defined %}
                    members:
{%- for sub in p.members %}
{%- if 'v' in sub %}
                    - type: sriov_vf
                      device: {{ sub.split('v')[0] }}
                      vfid: {{ sub.split('v')[1] }}
{%- else %}
                    - type: interface
                      name: {{ sub }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- for network in roles_networks[item.name] if network in (bridge.vlans | default([])) %}
                - type: vlan
                  mtu:
                    get_param: {{ network }}Mtu
                  vlan_id:
                    get_param: {{ network }}NetworkVlanID
                  addresses:
                  - ip_netmask:
                      get_param: {{ network }}IpSubnet
                  routes:
                    list_concat_unique:
                      - get_param: {{ network }}InterfaceRoutes
{%- endfor %}
{%- endif %}
{%- endfor %}

outputs:
  OS::stack_id:
    description: The OsNetConfigImpl resource.
    value:
      get_resource: OsNetConfigImpl
