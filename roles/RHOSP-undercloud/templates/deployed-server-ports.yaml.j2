{% if (RHOSP_version < 17.1) and deployed_server[leaf.name] %}
# Map default heat hostnames to pre-provisioned node names and pin each ctlplane port to its static ctlplane_ip.
resource_registry:
  OS::TripleO::DeployedServer::ControlPlanePort: /usr/share/openstack-tripleo-heat-templates/deployed-server/deployed-neutron-port.yaml

parameter_defaults:
  DeployedServerPortMap:
{% for ocrole in overcloud_roles if roles_count[leaf.name][ocrole.name] > 0 %}
{% set nodes = (libvirt_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('libvirt.hypervisor', 'equalto', leaf.hypervisor) | list) + (physical_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('openstack.leaf', 'equalto', leaf.name) | list) %}
{% for node in nodes %}
    {{ node.name }}-ctlplane:
      fixed_ips:
        - ip_address: {{ node.openstack.ctlplane_ip }}
      subnets:
        - cidr: {{ leaf.ctlplane_subnet.cidr }}
      network:
        tags:
          - {{ leaf.ctlplane_subnet.cidr }}
{% endfor %}
{% endfor %}
  HostnameMap:
{% for ocrole in overcloud_roles if roles_count[leaf.name][ocrole.name] > 0 %}
{% set nodes = (libvirt_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('libvirt.hypervisor', 'equalto', leaf.hypervisor) | list) + (physical_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('openstack.leaf', 'equalto', leaf.name) | list) %}
{% for node in nodes %}
    {{ leaf.name }}-{{ ocrole.name | lower }}-{{ loop.index0 }}: {{ node.name }}
{% endfor %}
{% endfor %}
{% endif %}
