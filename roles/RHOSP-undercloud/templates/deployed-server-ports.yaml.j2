{% if (RHOSP_version < 17.1) and deployed_server[leaf.name] %}
# Deployed-server (pre-provisioned) control-plane port and hostname mapping.
# The default heat hostnames (%stackname%-<role>-%index%, once HostnameFormatDefault
# is stripped from roles_data.yaml by deploy.sh) are mapped to the pre-provisioned
# node names, and each node's ctlplane port is pinned to the static ctlplane_ip that
# cloud-init already assigned to it.
resource_registry:
  OS::TripleO::DeployedServer::ControlPlanePort: /usr/share/openstack-tripleo-heat-templates/deployed-server/deployed-neutron-port.yaml

parameter_defaults:
  DeployedServerPortMap:
{% for ocrole in overcloud_roles if roles_count[leaf.name][ocrole.name] > 0 %}
{% set nodes = (libvirt_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('libvirt.hypervisor', 'in', leaf.hypervisor) | list) + (physical_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('openstack.leaf', 'equalto', leaf.name) | list) %}
{% for node in nodes %}
    {{ node.name }}-ctlplane:
      fixed_ips:
        - ip_address: {{ node.openstack.ctlplane_ip }}
      subnets:
        - cidr: {{ leaf.subnet.cidr }}
      network:
        tags:
          - {{ leaf.subnet.cidr }}
{% endfor %}
{% endfor %}
  HostnameMap:
{% for ocrole in overcloud_roles if roles_count[leaf.name][ocrole.name] > 0 %}
{% set nodes = (libvirt_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('libvirt.hypervisor', 'in', leaf.hypervisor) | list) + (physical_machines | selectattr('openstack.role', 'equalto', ocrole.profile) | selectattr('openstack.leaf', 'equalto', leaf.name) | list) %}
{% for node in nodes %}
    {{ leaf.name }}-{{ ocrole.name | lower }}-{{ loop.index0 }}: {{ node.name }}
{% endfor %}
{% endfor %}
{% endif %}
