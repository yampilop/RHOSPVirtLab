{% if RHOSP_version < 17.1 %}{# IF 0 #}

parameter_defaults:
{% for ocrole in overcloud_roles %}{# IF 0 FOR 1 #}
{% if roles_count[leaf.name][ocrole.name] > 0 %}{# IF 0 FOR 1 IF 1 #}
  Overcloud{{ ocrole.name }}Flavor: baremetal
  {{ ocrole.name }}Count: {{ roles_count[leaf.name][ocrole.name] }}
{% endif %}{# IF 0 FOR 1 IF 1 #}
{% endfor %}{# IF 0 FOR 1 #}

{% else %}{# IF 0 #}

{% if leaf.name != default_leaf.name %}{# IF 0.1 #}
{% set name = "_" ~ leaf.name %}
{% else %}{# IF 0.1 #}
{% set name = "" %}
{% endif %}{# IF 0.1 #}

{% macro net_list(ocrole, name, ctlplane_ip='') %}
    networks:
    - network: ctlplane
{% if ctlplane_ip %}{# MACRO IF 1 #}
      fixed_ip: {{ ctlplane_ip }}
{% endif %}{# MACRO IF 1 #}
{% if not deployed_server[leaf.name] %}{# MACRO IF 2 #}
      vif: true
{% endif %}{# MACRO IF 2 #}
{% for network in leaf.networks if network.name in roles_networks[ocrole.name] %}{# MACRO FOR 1 #}
    - network: {{ network.name | regex_replace('([a-z0-9])([A-Z])', '\\1_\\2') | lower }}
      subnet: {{ network.name | regex_replace('([a-z0-9])([A-Z])', '\\1_\\2') | lower }}_subnet{{ name }}
{% endfor %}{# MACRO FOR 1 #}
{%- endmacro %}

{% for ocrole in overcloud_roles %}{# IF 0 FOR 2 #}
{% if roles_count[leaf.name][ocrole.name] > 0 %}{# IF 0 FOR 2 IF 1 #}
- name: {{ ocrole.name }}
  count: {{ roles_count[leaf.name][ocrole.name] }}
{% if not deployed_server[leaf.name] %}{# IF 0 FOR 2 IF 1 IF 1 #}
{% if ocrole.name == 'Controller' %}{# IF 0 FOR 2 IF 1 IF 1 IF 1 #}
  ansible_playbooks:
  - playbook: /usr/share/ansible/tripleo-playbooks/cli-overcloud-node-growvols.yaml
    extra_vars:
      growvols_args: >
        /=8GB
        /tmp=1GB
        /var/log=10GB
        /var/log/audit=2GB
        /home=1GB
        /srv=10GB
        /var=100%
{% endif %}{# IF 0 FOR 2 IF 1 IF 1 IF 1 #}
{% if ('Sriov' in ocrole.name) or ('OvsHwOffload' in ocrole.name) or ('OvsDpdk' in ocrole.name) %}{# IF 0 FOR 2 IF 1 IF 1 IF 2 #}
  ansible_playbooks:
  - playbook: /usr/share/ansible/tripleo-playbooks/cli-overcloud-node-kernelargs.yaml
    extra_vars:
      kernel_args: 'default_hugepagesz={{ vars[ocrole.name + 'Properties'].hugepagesz }} hugepagesz={{ vars[ocrole.name + 'Properties'].hugepagesz }} hugepages={{ vars[ocrole.name + 'Properties'].hugepages }} {{ vars[ocrole.name + 'Properties'].kernelargs }} isolcpus={{ vars[ocrole.name + 'Properties'].isolcpus }}'
      tuned_isolated_cores: '{{ vars[ocrole.name + 'Properties'].isolcpus }}'
      tuned_profile: 'cpu-partitioning'
      reboot_wait_timeout: 1800
{% endif %}{# IF 0 FOR 2 IF 1 IF 1 IF 2 #}
{% if 'OvsDpdk' in ocrole.name %}{# IF 0 FOR 2 IF 1 IF 1 IF 3 #}
  - playbook: /usr/share/ansible/tripleo-playbooks/cli-overcloud-openvswitch-dpdk.yaml
    extra_vars:
      pmd: '{{ vars[ocrole.name + 'Properties'].ovspmdcorelist }}'
      memory_channels: '{{ vars[ocrole.name + 'Properties'].memorychannels }}'
      socket_mem: '{{ vars[ocrole.name + 'Properties'].socketmemory }}'
{% endif %}{# IF 0 FOR 2 IF 1 IF 1 IF 3 #}
{% endif %}{# IF 0 FOR 2 IF 1 IF 1 #}
  defaults:
{% if deployed_server[leaf.name] %}{# IF 0 FOR 2 IF 1 IF 2 #}
    managed: false
{% endif %}{# IF 0 FOR 2 IF 1 IF 2 #}
{{ net_list(ocrole, name) }}
{% if not deployed_server[leaf.name] %}{# IF 0 FOR 2 IF 1 IF 3 #}
    network_config:
      network_config_update: true
      template: /home/stack/templates/{{ leaf.name ~ "/" if leaf.name != default_leaf.name else "" }}nic-configs/{{ ocrole.profile }}.j2
      default_route_network:
      - {{ (leaf.networks | default([]) | selectattr('name', 'equalto', 'External') | list | first).name | regex_replace('([a-z0-9])([A-Z])', '\\1_\\2') | lower
         if (default_leaf.networks | default([]) | selectattr('name', 'equalto', 'External') | list | length > 0)
         else 'ctlplane' }}
    swap_size_mb: 8192
{% endif %}{# IF 0 FOR 2 IF 1 IF 3 #}
{% endif %}{# IF 0 FOR 2 IF 1 #}
  instances:
{% if leaf.hypervisor is defined %}{# IF 1 #}
{% for vm in (libvirt_machines | selectattr("openstack.role", "equalto", ocrole.profile) | selectattr("libvirt.hypervisor", "in", leaf.hypervisor.split(','))) %}{# IF 1 FOR 1 #}
{% if deployed_server[leaf.name] %}{# IF 1 FOR 1 IF 1 #}
  - name: {{ vm.name }}
    hostname: {{ vm.name }}
{{ net_list(ocrole, name, vm.openstack.ctlplane_ip) }}
{% else %}{# IF 1 FOR 1 IF 1 #}
  - name: {{ leaf.name }}-{{ vm.name }}
{% if vm.pm.mode != 'uefi' %}{# IF 1 FOR 1 IF 2 #}
    image:
      href: "file:///var/lib/ironic/images/overcloud-full.raw"
      kernel: "file:///var/lib/ironic/images/overcloud-full.vmlinuz"
      ramdisk: "file:///var/lib/ironic/images/overcloud-full.initrd"
    root_size_gb: {{ ((vm.libvirt.disks | selectattr('root', 'defined') | selectattr('root') | list | first).size / 1073741824) | int - 9 }}
{% endif %}{# IF 1 FOR 1 IF 2 #}
{% endif %}{# IF 1 FOR 1 IF 1 #}
{% endfor %}{# IF 1 FOR 1 #}
{% for pm in (physical_machines | selectattr("openstack.role", "equalto", ocrole.profile) | selectattr("openstack.leaf", "equalto", leaf.name)) %}{# IF 1 FOR 2 #}
{% if deployed_server[leaf.name] %}{# IF 1 FOR 2 IF 1 #}
  - name: {{ pm.name }}
    hostname: {{ pm.name }}
{{ net_list(ocrole, name, pm.openstack.ctlplane_ip) }}
{% else %}{# IF 1 FOR 2 IF 1 #}
  - name: {{ leaf.name }}-{{ pm.name }}
{% if pm.pm.mode != 'uefi' %}{# IF 1 FOR 2 IF 2 #}
    image:
      href: "file:///var/lib/ironic/images/overcloud-full.raw"
      kernel: "file:///var/lib/ironic/images/overcloud-full.vmlinuz"
      ramdisk: "file:///var/lib/ironic/images/overcloud-full.initrd"
    root_size_gb: {{ (pm.physical.disk / 1073741824) | int - 9 }}
    network_config:
      net_config_data_lookup:
        {{ leaf.name }}-{{ pm.name }}:
{% for nic, interface in pm.physical.nics.items() %}{# IF 1 FOR 2 IF 2 FOR 1 #}
          {{ nic }}: '{{ pm.physical.mac if nic == 'nic1' else interface }}'
{% endfor %}{# IF 1 FOR 2 IF 2 FOR 1 #}
{% endif %}{# IF 1 FOR 2 IF 2 #}
{% endif %}{# IF 1 FOR 2 IF 1 #}
{% endfor %}{# IF 1 FOR 2 #}
{% else %}{# IF 1 #}
{% for vm in (kubevirt_machines | selectattr("openstack.role", "equalto", ocrole.profile)) %}{# IF 1 FOR 3 #}
  - name: {{ vm.name }}
    hostname: {{ vm.name }}
{{ net_list(ocrole, name, vm.openstack.ctlplane_ip if vm.openstack.ctlplane_ip is defined else '') }}
{% endfor %}{# IF 1 FOR 3 #}
{% endif %}{# IF 1 #}
{% endfor %}{# FOR ocrole #}
{% endif %}{# IF RHOSP_version < 17.1 #}
