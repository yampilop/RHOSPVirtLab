{% if RHOSP_version < 17.1 %}
resource_registry:
{% for ocrole in overcloud_roles %}
{% if roles_count[leaf.name][ocrole.name] > 0 %}
{% if (leaf.hypervisor is defined and default_leaf.hypervisor is defined and leaf.hypervisor == default_leaf.hypervisor) or (leaf.hypervisor is not defined and default_leaf.hypervisor is not defined) %}
  OS::TripleO::{{ ocrole.name }}::Net::SoftwareConfig: /home/stack/templates/nic-configs/{{ ocrole.profile }}.yaml
{% else %}
  OS::TripleO::{{ ocrole.name }}::Net::SoftwareConfig: /home/stack/templates/{{ leaf.name }}/nic-configs/{{ ocrole.profile }}.yaml
{% endif %}
{% endif %}
{% endfor %}
{% if (RHOSP_version < 17.1) and (physical_machines | selectattr("openstack.leaf", "equalto", leaf.name) | list | count) > 0 %}
  OS::TripleO::NodeUserData: /usr/share/openstack-tripleo-heat-templates/firstboot/os-net-config-mappings.yaml
{% endif %}
{% endif %}

parameter_defaults:
{% if RHOSP_version < 17.1 %}
  NetworkDeploymentActions: ['CREATE','UPDATE']
{% else %}
{% for ocrole in overcloud_roles %}
{% if roles_count[leaf.name][ocrole.name] > 0 %}
{% if (leaf.hypervisor is defined and default_leaf.hypervisor is defined and leaf.hypervisor == default_leaf.hypervisor) or (leaf.hypervisor is not defined and default_leaf.hypervisor is not defined) %}
  {{ ocrole.name }}NetworkConfigTemplate: '/home/stack/templates/nic-configs/{{ ocrole.profile }}.j2'
{% else %}
  {{ ocrole.name }}NetworkConfigTemplate: '/home/stack/templates/{{ leaf.name }}/nic-configs/{{ ocrole.profile }}.j2'
{% endif %}
  {{ ocrole.name }}NetworkConfigUpdate: true
{% endif %}
{% endfor %}
{% endif %}
  DnsServers: {{ dns_servers | join(',') }}
  NtpServer:
{% for server in ntp_servers %}
    - {{ server }}
{% endfor %}
  ControlPlaneDefaultRoute: {{ leaf.ctlplane_subnet.gateway }}
  ControlPlaneSubnet: {{ leaf.ctlplane_subnet.name }}
{% if NeutronDriver == 'ovn' %}
  NeutronTunnelTypes: 'geneve'
  NeutronNetworkType: 'geneve,vlan'
{% else %}
  NeutronOVSFirewallDriver: openvswitch
{% endif %}
  
{% if ((RHOSP_version < 17.1) or deployed_server[leaf.name]) and (physical_machines | selectattr("openstack.leaf", "equalto", leaf.name) | list | count) > 0 %}
  NetConfigDataLookup:
{% for pm in physical_machines if pm.openstack.leaf == leaf.name %}
    node{{ loop.index }}:
{% for nic, interface in pm.physical.nics.items() %}
      {{ nic }}: '{{ pm.physical.mac if nic == 'nic1' else interface }}'
{% endfor %}
{% endfor %}
{% endif %}

{% if dcn_leafs | length > 0 %}
  NeutronDefaultAvailabilityZones: '{{ default_leaf.name }},{% for leaf in dcn_leafs %}{{ leaf.name }}{{ "," if not loop.last else "" }}{% endfor %}'
{% if NeutronDriver == 'ovs' %}
  NeutronL3AgentAvailabilityZone: '{{ default_leaf.name }},{% for leaf in dcn_leafs %}{{ leaf.name }}{{ "," if not loop.last else "" }}{% endfor %}'
  NeutronDhcpAgentAvailabilityZone: '{{ default_leaf.name }},{% for leaf in dcn_leafs %}{{ leaf.name }}{{ "," if not loop.last else "" }}{% endfor %}'
{% endif %}
{% for ocrole in overcloud_roles if (ocrole.virtual | bool) %}
{% if roles_count[leaf.name][ocrole.name] > 0 %}
  {{ ocrole.name }}ControlPlaneSubnet: {{ leaf.ctlplane_subnet.name }}
  {{ ocrole.name }}Parameters:
{% if leaf.name != default_leaf.name %}
    NeutronBridgeMappings: "datacentre-{{ leaf.name }}:br-ex"
{% else %}
    NeutronBridgeMappings: "datacentre:br-ex"
{% endif %}
{% endif %}
{% endfor %}
{% if NeutronDriver == 'ovn' %}
  OVNDBSPacemakerTimeout: 360
  OVNRemoteProbeInterval: 180000
  OVNOpenflowProbeInterval: 180
  ControllerParameters:
    OVNCMSOptions: "enable-chassis-as-gw,availability-zones={{ default_leaf.name }}:{% for leaf in dcn_leafs %}{{ leaf.name }}{{ ":" if not loop.last else "" }}{% endfor %}"
{% endif %}

{% endif %}

{% if DeployFrr %}
  FrrOvnBgpAgentDriver: 'ovn_bgp_driver'
{% endif %}

{{ NetworkParameterDefaults | to_yaml | indent(width=2) }}