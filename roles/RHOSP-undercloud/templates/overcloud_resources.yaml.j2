{#- Widest free gap in an External subnet (excluding allocation_pools and gateway),
    returned as "start end" for use as the neutron provider floating-IP pool. -#}
{%- macro external_floating_pool(ext) -%}
{%- set lo = (ext.subnet.ip_subnet | ansible.utils.ipaddr('network') | ansible.utils.ipaddr('int') | int) + 1 -%}
{%- set hi = (ext.subnet.ip_subnet | ansible.utils.ipaddr('broadcast') | ansible.utils.ipaddr('int') | int) - 1 -%}
{%- set used = [] -%}
{%- for p in ext.subnet.allocation_pools -%}
{%- set _ = used.append([p.start | ansible.utils.ipaddr('int') | int, p.end | ansible.utils.ipaddr('int') | int]) -%}
{%- endfor -%}
{%- if ext.subnet.gateway is defined -%}
{%- set g = ext.subnet.gateway | ansible.utils.ipaddr('int') | int -%}
{%- set _ = used.append([g, g]) -%}
{%- endif -%}
{%- set ns = namespace(cursor=lo, bstart=0, bend=-1, blen=0) -%}
{%- for iv in used | sort -%}
{%- if iv[0] > ns.cursor and (iv[0] - ns.cursor) > ns.blen -%}
{%- set ns.blen = iv[0] - ns.cursor -%}{%- set ns.bstart = ns.cursor -%}{%- set ns.bend = iv[0] - 1 -%}
{%- endif -%}
{%- if iv[1] + 1 > ns.cursor -%}{%- set ns.cursor = iv[1] + 1 -%}{%- endif -%}
{%- endfor -%}
{%- if hi >= ns.cursor and (hi - ns.cursor + 1) > ns.blen -%}
{%- set ns.bstart = ns.cursor -%}{%- set ns.bend = hi -%}
{%- endif -%}
{{ (ns.bstart | ansible.utils.ipaddr) ~ ' ' ~ (ns.bend | ansible.utils.ipaddr) }}
{%- endmacro -%}
{% set dpdk_count = (roles_count[default_leaf.name]["ComputeOvsDpdk"] + roles_count[default_leaf.name]["ComputeOvsDpdkSriov"]) %}
{% set sriov_count = (roles_count[default_leaf.name]["ComputeSriov"] + roles_count[default_leaf.name]["ComputeOvsHwOffload"] + roles_count[default_leaf.name]["ComputeOvsDpdkSriov"]) %}
{% set ceph_count = (roles_count[default_leaf.name]["CephStorage"] + roles_count[default_leaf.name]["CephAll"]) %}
{% set hci_count = (roles_count[default_leaf.name]["ComputeHCI"] + roles_count[default_leaf.name]["DistributedComputeHCI"] + roles_count[default_leaf.name]["DistributedComputeHCIScaleOut"]) %}

heat_template_version: {{ RHOSP_version_supported[RHOSP_version].heat_template_version }}

description: >
  HOT Template to create basic needed resources after deployment of RHOSPVirtLab

parameters:
  user_name:
    type: string
    description: User name
    default: test-admin
  user_password:
    type: string
    description: User name
    default: {{ TestUserPassword }}
  image_rhel_external_id:
    type: string
    description: External ID to reference RHEL image
    default: ''
  image_cirros_external_id:
    type: string
    description: External ID to reference CirrOS image
    default: ''
  default_security_group_id:
    type: string
    description: External ID to reference the default security group
    default: ''

resources:
{% set ext_list = default_leaf.networks | selectattr('name', 'equalto', 'External') | list %}
{% if ext_list | length > 0 %}
{% set ext = ext_list[0] %}
{% set fb = (external_floating_pool(ext) | trim).split() %}
  # Provider network resources
  default_provider_network:
    type: OS::Neutron::ProviderNet
    properties:
      name: default-provider
      network_type: {{ 'vlan' if (ext.subnet.vlan is defined) else 'flat' }}
      physical_network: datacentre
{% if (ext.subnet.vlan is defined) %}
      segmentation_id: {{ ext.subnet.vlan | default('') }}
{% endif %}
      router_external: True
      port_security_enabled: True
      shared: True
  default_provider_subnet:
    type: OS::Neutron::Subnet
    depends_on: default_provider_network
    properties:
      name: default-provider-subnet
      network: { get_resource: default_provider_network }
      ip_version: 4
      allocation_pools:
        - start: {{ fb[0] }}
          end: {{ fb[1] }}
      cidr: {{ ext.subnet.ip_subnet }}
      enable_dhcp: True
      gateway_ip: {{ ext.subnet.gateway }}
  default_router:
    type: OS::Neutron::Router
    depends_on: default_provider_network
    properties:
      name: default-router
      external_gateway_info:
        network: { get_resource: default_provider_network }
        enable_snat: True
{% endif %}

{% for leaf in dcn_leafs %}
{% set lext_list = leaf.networks | selectattr('name', 'equalto', 'External') | list %}
{% if lext_list | length > 0 %}
{% set lext = lext_list[0] %}
{% set lfb = (external_floating_pool(lext) | trim).split() %}
  # Provider network resources for DCN {{ leaf.name }}
  default_provider_network_{{ leaf.name }}:
    type: OS::Neutron::ProviderNet
    properties:
      name: default-provider-{{ leaf.name }}
      network_type: {{ 'vlan' if (lext.subnet.vlan is defined) else 'flat' }}
      physical_network: datacentre-{{ leaf.name }}
{% if lext.subnet.vlan is defined %}
      segmentation_id: {{ lext.subnet.vlan | default('') }}
{% endif %}
      router_external: True
      port_security_enabled: True
      shared: True
  default_provider_subnet_{{ leaf.name }}:
    type: OS::Neutron::Subnet
    depends_on: default_provider_network_{{ leaf.name }}
    properties:
      name: default-provider-{{ leaf.name }}-subnet
      network: { get_resource: default_provider_network_{{ leaf.name }} }
      ip_version: 4
      allocation_pools:
        - start: {{ lfb[0] }}
          end: {{ lfb[1] }}
      cidr: {{ lext.subnet.ip_subnet }}
      enable_dhcp: True
      gateway_ip: {{ lext.subnet.gateway }}
  default_router_{{ leaf.name }}:
    type: OS::Neutron::Router
    depends_on: default_provider_network_{{ leaf.name }}
    properties:
      name: default-router-{{ leaf.name }}
      external_gateway_info:
        network: { get_resource: default_provider_network_{{ leaf.name }} }
        enable_snat: True
{% endif %}
{% endfor %}
  # Flavor resources
{% for size in DefaultFlavorsSize %}
  flavor_m1_{{ size.name }}:
    type: OS::Nova::Flavor
    properties:
      name: m1.{{ size.name }}
      vcpus: {{ size.vcpus }}
      ram: {{ size.ram }}
      disk: {{ size.disk }}
      ephemeral: {{ size.ephemeral }}
      swap: {{ size.swap }}
      is_public: True
{% if dpdk_count > 0 %}
  flavor_pinned_{{ size.name }}:
    type: OS::Nova::Flavor
    properties:
      name: pinned.{{ size.name }}
      vcpus: {{ size.vcpus }}
      ram: {{ size.ram }}
      disk: {{ size.disk }}
      ephemeral: {{ size.ephemeral }}
      swap: {{ size.swap }}
      is_public: True
      extra_specs: { "hw:cpu_policy": "dedicated", "hw:mem_page_size": "large" }
{% endif %}
{% if sriov_count > 0 %}
  flavor_sriov_{{ size.name }}:
    type: OS::Nova::Flavor
    properties:
      name: sriov.{{ size.name }}
      vcpus: {{ size.vcpus }}
      ram: {{ size.ram }}
      disk: {{ size.disk }}
      ephemeral: {{ size.ephemeral }}
      swap: {{ size.swap }}
      is_public: True
      extra_specs: { "sriov": true, "hw:cpu_policy": "dedicated", "hw:mem_page_size": "large" }
{% endif %}
{% endfor %}

  # Image resources
  image_rhel:
    type: OS::Glance::Image
    external_id: { get_param: image_rhel_external_id }
  image_cirros:
    type: OS::Glance::Image
    external_id: { get_param: image_cirros_external_id }

{% if DeployOctavia and RHOSP_version >= 17 %}
  # Octavia resources
  amphora_single_profile:
    type: OS::Octavia::FlavorProfile
    properties:
      name: amphora-single-profile
      provider_name: amphora
      flavor_data: '{"loadbalancer_topology": "SINGLE"}'
  standalone_lb:
    type: OS::Octavia::Flavor
    depends_on: amphora_single_profile
    properties:
      name: standalone-lb
      description: A non-high availability load balancer for testing.
      enabled: True
      flavor_profile: { get_resource: amphora_single_profile }

{% endif %}
  # Host aggregate resources
{% if dpdk_count > 0 %}
  aggregate_dpdk_hosts:
    type: OS::Nova::HostAggregate
    properties:
      name: dpdk_hosts
      hosts: [{% for node in (physical_machines | selectattr("openstack.role", "contains", "Dpdk")) %}{{ node.name }}.localdomain{{ "," if not loop.last else "" }}{% endfor %}]
      metadata: { "dpdk": true }
{% endif %}
{% if sriov_count > 0 %}
  aggregate_sriov_hosts:
    type: OS::Nova::HostAggregate
    properties:
      name: sriov_hosts
      hosts: [{% for node in (physical_machines | selectattr("openstack.role", "match", "Sriov|HwOffload")) %}{{ node.name }}.localdomain{{ "," if not loop.last else "" }}{% endfor %}]
      metadata: { "sriov": true }
{% endif %}

  # Server group resources
  affinity_group:
    type: OS::Nova::ServerGroup
    properties:
      name: affinity-group
      policies: ['affinity']
  anti_affinity_group:
    type: OS::Nova::ServerGroup
    properties:
      name: anti-affinity-group
      policies: ['anti-affinity']
  soft_affinity_group:
    type: OS::Nova::ServerGroup
    properties:
      name: soft-affinity-group
      policies: ['soft-affinity']
  soft_anti_affinity_group:
    type: OS::Nova::ServerGroup
    properties:
      name: soft-anti-affinity-group
      policies: ['soft-anti-affinity']

  # Keystone resources
  user:
    type: OS::Keystone::User
    properties:
      name: { get_param: user_name }
      description: Test admin user
      enabled: True
      password: { get_param: user_password }
      default_project: admin
      roles:
        - role: admin
          domain: Default
        - role: admin
          project: admin

  # Keypair resources
  undercloud_key:
    type: OS::Nova::KeyPair
    depends_on: user
    properties:
      name: undercloud-key
      public_key: { get_file: '/home/stack/.ssh/id_rsa.pub' }
      user: { get_resource: user }

  # Tenant network resources
  test_network:
    type: OS::Neutron::Net
    properties:
      name: test-network
  test_subnet:
    type: OS::Neutron::Subnet
    depends_on: test_network
    properties:
      name: test-subnet
      network: { get_resource: test_network }
      ip_version: 4
      cidr: 192.168.1.0/24
      enable_dhcp: True
      gateway_ip: 192.168.1.1
  test_subnet_gateway:
    type: OS::Neutron::Port
    depends_on: test_subnet
    properties:
      name: test-subnet-gw
      network: { get_resource: test_network }
      fixed_ips:
        - subnet: { get_resource: test_subnet }
          ip_address: 192.168.1.1
  default_router_interface:
    type: OS::Neutron::RouterInterface
    depends_on:
      - default_router
      - test_subnet_gateway
    properties:
      port: { get_resource: test_subnet_gateway }
      router: { get_resource: default_router }
{% for leaf in dcn_leafs %}
  test_network_{{ leaf.name }}:
    type: OS::Neutron::Net
    properties:
      name: test-network-{{ leaf.name }}
  test_subnet_{{ leaf.name }}:
    type: OS::Neutron::Subnet
    depends_on: test_network_{{ leaf.name }}
    properties:
      name: test-subnet-{{ leaf.name }}
      network: { get_resource: test_network_{{ leaf.name }} }
      ip_version: 4
      cidr: 192.168.1.0/24
      enable_dhcp: True
      gateway_ip: 192.168.1.1
  test_subnet_gateway_{{ leaf.name }}:
    type: OS::Neutron::Port
    depends_on: test_subnet_{{ leaf.name }}
    properties:
      name: test-subnet-gw-{{ leaf.name }}
      network: { get_resource: test_network_{{ leaf.name }} }
      fixed_ips:
        - subnet: { get_resource: test_subnet_{{ leaf.name }} }
          ip_address: 192.168.1.1
  default_router_interface_{{ leaf.name }}:
    type: OS::Neutron::RouterInterface
    depends_on:
      - default_router_{{ leaf.name }}
      - test_subnet_gateway_{{ leaf.name }}
    properties:
      port: { get_resource: test_subnet_gateway_{{ leaf.name }} }
      router: { get_resource: default_router_{{ leaf.name }} }
{% endfor %}

  # Security group resources
  default_security_group:
    type: OS::Neutron::SecurityGroup
    external_id: { get_param: default_security_group_id }
  default_security_group_ssh_rule:
    type: OS::Neutron::SecurityGroupRule
    depends_on: default_security_group
    properties:
      description: SSH
      port_range_max: 22
      port_range_min: 22
      protocol: tcp
      remote_ip_prefix: 0.0.0.0/0
      security_group: { get_resource: default_security_group }
  default_security_group_icmp_rule:
    type: OS::Neutron::SecurityGroupRule
    depends_on: default_security_group
    properties:
      description: ICMP
      protocol: icmp
      security_group: { get_resource: default_security_group }

outputs:
  user_id:
    description: test-admin user UUID
    value: { get_resource: user }