#!/bin/bash

source /home/stack/stackrc

{% if leaf.name == default_leaf.name %}
{% set templates_dir='/home/stack/templates' %}
{% set ceph_count = (libvirt_machines + physical_machines + kubevirt_machines) | selectattr('openstack.role', 'in', ['cephstorage', 'cephall']) | list | length %}
{% set hci_count = (libvirt_machines + physical_machines + kubevirt_machines) | selectattr('openstack.role', 'in', ['computehci', 'distributedcomputehci', 'distributedcomputehciscaleout']) | list | length %}

# Auto source and completion
if [ ! -f /usr/share/bash-completion/completions/openstack ]; then
  openstack complete 2>/dev/null | grep -v -E 'DEBUG osc_lib|INFO osc_lib' | sudo tee /usr/share/bash-completion/completions/openstack
fi

if ! grep -Fxq "source /home/stack/stackrc" /home/stack/.bashrc; then
  echo "source /home/stack/stackrc" >> /home/stack/.bashrc
fi

if ! grep -Fxq "source /usr/share/bash-completion/completions/openstack" /home/stack/.bashrc; then
  echo "source /usr/share/bash-completion/completions/openstack" >> /home/stack/.bashrc
fi

# Prepare the overcloud
openstack overcloud image upload --image-path /home/stack/images/
{% if RHOSP_version >= 17.1 %}
openstack overcloud image upload --image-path /home/stack/images/ --os-image-name overcloud-full.qcow2
ls -al /var/lib/ironic/images/
{% else %}
openstack image list --fit-width
{% endif %}

{% else %}
{% set templates_dir="/home/stack/templates/" ~ leaf.name %}
{% endif %}

{% if RHOSP_version >= 17.1 %}
{% if leaf.name == default_leaf.name %}
# Provision networks and vips
openstack overcloud network provision -y --output {{ templates_dir }}/overcloud-networks-deployed.yaml {{ templates_dir }}/network_data.yaml
openstack overcloud network vip provision -y --stack {{ leaf.name }} --output {{ templates_dir }}/overcloud-vip-deployed.yaml {{ templates_dir }}/vip_data.yaml
{% else %}
# Copy the central site network and vip files
cp /home/stack/templates/overcloud-networks-deployed.yaml {{ templates_dir }}/overcloud-networks-deployed.yaml
cp /home/stack/templates/overcloud-vip-deployed.yaml {{ templates_dir }}/overcloud-vip-deployed.yaml
{% endif %}
{% endif %}

{% if not deployed_server[leaf.name] %}
# Prepare baremetal nodes
openstack overcloud node import {{ templates_dir }}/instackenv.yaml
openstack baremetal node list
openstack baremetal node list -f value -c Name -c 'Power State' | grep 'power on' | grep 'manageable' | awk {'system("openstack baremetal node power off "$1)'}
openstack baremetal node list

# Introspect baremetal nodes
openstack overcloud node introspect --all-manageable --provide
openstack baremetal node list
{% else %}
# Pre-provisioned nodes: skip import/introspection (OS already up at its static ctlplane IP)
{% endif %}


# Prepare images
{% if RHOSP_version >= 17.1 %}
sudo openstack tripleo container image prepare \
-e /home/stack/containers-prepare-parameter.yaml \
--output-env-file {{ templates_dir }}/overcloud-images.yaml
{% else %}
sudo openstack tripleo container image prepare \
{% if leaf.name != default_leaf.name %}
-e /home/stack/templates/overcloud-export.yaml \
{% endif %}
-e /home/stack/containers-prepare-parameter.yaml \
--output-env-file {{ templates_dir }}/overcloud-images.yaml
{% endif %}

{% if RHOSP_version >= 17.1 %}
# Provision nodes
{% if deployed_server[leaf.name] %}
# Deployed servers (managed:false): authors overcloud-baremetal-deployed.yaml with network configuration
openstack overcloud node provision -y --stack {{ leaf.name }} --network-config --output {{ templates_dir }}/overcloud-baremetal-deployed.yaml {{ templates_dir }}/node-info.yaml
{% else %}
openstack overcloud node provision -y --stack {{ leaf.name }} --network-config --output {{ templates_dir }}/overcloud-baremetal-deployed.yaml {{ templates_dir }}/node-info.yaml
metalsmith list
{% endif %}
{% endif %}

{% if deployed_server[leaf.name] and (rh_activationkey is defined and rh_activationkey or rh_username is defined and rh_username) %}
# Prepare pre-provisioned nodes with subscription, repos, and updates
{% if rh_activationkey is defined and rh_activationkey %}
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo subscription-manager register --org={{ rh_orgid }} --activationkey={{ rh_activationkey }}" || true
{% if rh_pool is defined and rh_pool %}
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo subscription-manager attach --pool={{ rh_pool }}" || true
{% endif %}
{% elif rh_username is defined and rh_username %}
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo subscription-manager register --username {{ rh_username }} --password {{ rh_password }}" || true
{% if rh_pool is defined and rh_pool %}
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo subscription-manager attach --pool={{ rh_pool }}" || true
{% endif %}
{% endif %}
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo subscription-manager release --set={{ RHOSP_version_supported[RHOSP_version].rhel_release }}"
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo subscription-manager repos --enable={{ RHOSP_version_supported[RHOSP_version].nodes_repos | join(' --enable=') }}"
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo dnf update -y"
{% endif %}

{% if deployed_server[leaf.name] %}
# Clear MySQL password on pre-provisioned controller nodes (KCS 7060294)
# Only on stack updates, not initial deployment (check if config dirs exist)
# https://access.redhat.com/solutions/7060294
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} Controller -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "test -d /var/lib/config-data && sudo rm -f /var/lib/config-data/puppet-generated/mysql/root/.my.cnf /var/lib/config-data/mysql/root/.my.cnf" 2>/dev/null || true
{% endif %}


{% if RHOSP_version >= 17.1 and deployed_server[leaf.name] and (ceph_count | default(0) + hci_count | default(0) > 0) %}
# Install cephadm prerequisites on ceph nodes
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "sudo dnf install -y lvm2 podman jq"

# Authorize SSH public key for root access on ceph nodes for cephadm bootstrap
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} -b all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "mkdir -p /root/.ssh && chmod 700 /root/.ssh"
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} all -m copy -a "src=/home/stack/.ssh/id_rsa.pub dest=/tmp/authorized_key"
ansible -i /home/stack/pre_deployment_inventory.yaml -u {{ RHOSP_version_supported[RHOSP_version].overcloud_ssh_user }} -b all -e "ansible_python_interpreter=/usr/bin/python3" -m raw -a "cat /tmp/authorized_key >> /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys && rm /tmp/authorized_key"
{% endif %}

# Generate roles
openstack overcloud roles generate -o {{ templates_dir }}/roles_data.yaml {% for ocrole in overcloud_roles if roles_count[leaf.name][ocrole.name] > 0 %}{{ ocrole.name if (ocrole.copy_from is not defined) else (ocrole.copy_from ~ ':' ~ ocrole.name) }} {% endfor %}


# Remove HostnameFormatDefault parameter for roles to default to lowercase role name
sed -i -E '/HostnameFormatDefault: .+$/d' {{ templates_dir }}/roles_data.yaml

# Add External network where it's needed
{% for role, nets in roles_networks.items() if ('External' in nets) and (roles_count[leaf.name][role] > 0) %}
sed -i -Ez 's/- name: {{ role }}\n(([^-][^\n]*\n)+)  networks:\n    ([^E].+):/- name: {{ role }}\n\1  networks:\n    External:\n      subnet: external_subnet{{ '_' ~ leaf.name if leaf.name != default_leaf.name else '' }}\n    \3:/' {{ templates_dir }}/roles_data.yaml
{% endfor %}
{% if leaf.name != default_leaf.name %}
# Change the subnets for the leaf ones
sed -i -E 's/subnet: (.+_subnet)$/subnet: \1{{ '_' ~ leaf.name }}/g' {{ templates_dir }}/roles_data.yaml
{% endif %}