#!/bin/bash
#
# libvirt network hook.
#
# The lab's bridges are forward:bridge: the host owns the gateway IP (nmcli, see
# create_network_profiles.yml) and the host masquerades outbound traffic (firewalld,
# see configure_firewall.yml). What firewalld does NOT keep alive is the raw iptables
# FORWARD ACCEPT that lets replies back into each bridge: libvirt (re)inserts a
# FORWARD REJECT that shadows it whenever a network is started/restarted, so the rule
# vanishes on every libvirtd restart. This hook re-applies it on each network event.
#
# libvirt calls this as: network <network-name> <started|stopped|updated> ...

set -e
set -u

iptables='/usr/sbin/iptables'

# Map of managed libvirt network name -> host bridge, for every forward:bridge network
# that owns a gateway IP on this host (the ones the host masquerades).
declare -A bridges=(
{% for net in libvirt_networks if net.forward == 'bridge' and (net.ipv4 is defined) and ('localhost' in net.hypervisor.split(',')) %}
  ["{{ net.name }}"]="{{ net.bridge }}"
{% endfor %}
)

forward_update() {
  bridge="$1"
  action="$2"

  FORWARD="$iptables $action FORWARD -o $bridge -j ACCEPT"

  if [ -z "${DEBUG_RULES:-}" ]; then
    `$FORWARD`
  else
    echo $FORWARD
  fi
}

network_name="$1"
network_task="$2"

bridge="${bridges[$network_name]:-}"

if [ -n "${bridge}" ]; then

  case "${network_task}" in
    started)
      forward_update "${bridge}" " -I "
    ;;

    stopped)
      forward_update "${bridge}" " -D "
    ;;

    updated)
      forward_update "${bridge}" " -D "
      forward_update "${bridge}" " -I "
    ;;

    *)
      echo "network hook called with unexpected options $*" >&2
    ;;
  esac

fi
