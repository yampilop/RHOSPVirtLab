#!/bin/bash
# libvirt network hook: re-applies the FORWARD ACCEPT rule libvirt resets on every network (re)start for forward:bridge gateways; called as "network <name> <event> ...".

set -e
set -u

iptables='/usr/sbin/iptables'

# Map of managed libvirt network name -> host bridge, for every forward:bridge network
# that owns a gateway IP on this host (the ones the host masquerades).
declare -A bridges=(
{% for net in libvirt_networks if net.forward == 'bridge' and (net.ipv4 is defined) and ('localhost' in net.hypervisor.split(',')) %}
  ["{{ net.name }}"]="{{ net.bridge }}"
{% endfor %}
)

forward_update() {
  bridge="$1"
  action="$2"

  FORWARD="$iptables $action FORWARD -o $bridge -j ACCEPT"

  if [ -z "${DEBUG_RULES:-}" ]; then
    `$FORWARD`
  else
    echo $FORWARD
  fi
}

network_name="$1"
network_task="$2"

bridge="${bridges[$network_name]:-}"

if [ -n "${bridge}" ]; then

  case "${network_task}" in
    started)
      forward_update "${bridge}" " -I "
    ;;

    stopped)
      forward_update "${bridge}" " -D "
    ;;

    updated)
      forward_update "${bridge}" " -D "
      forward_update "${bridge}" " -I "
    ;;

    *)
      echo "network hook called with unexpected options $*" >&2
    ;;
  esac

fi
