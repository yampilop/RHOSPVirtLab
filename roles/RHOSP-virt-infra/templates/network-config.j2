version: 2
ethernets:
{# Management interface (Ansible-access NIC). The undercloud takes DHCP on the management
   NAT network: its lease is pinned, so it gets a deterministic IP plus the default route
   and DNS it needs to reach Red Hat / the internet for subscription, repos and image
   downloads. Overcloud nodes have no pinned lease, so they get a static IP from inventory
   and their default route on the ctlplane NIC below instead. #}
{% for iface in machine.libvirt.network.interfaces if iface.name == management_interface_name %}
  {{ iface.name }}:
    match:
      macaddress: '{{ iface.mac }}'
    set-name: {{ iface.name }}
{% if machine.openstack.role == 'undercloud' %}
    dhcp4: true
{% else %}
    addresses:
      - {{ hostvars[machine.name].ansible_host }}/24
{% endif %}
{% endfor %}
{# Pre-provisioned overcloud nodes: static ctlplane IP + default route for undercloud SSH. #}
{% if (machine.pre_provisioned | default(false)) and (machine.openstack.role != 'undercloud') and (machine.openstack.ctlplane_ip is defined) %}
{% set ctlplane_net = libvirt_networks | selectattr('name', 'search', 'RHOSPVirtLab_ctlplane') | list | first %}
{% for iface in machine.libvirt.network.interfaces if iface.bridge == ctlplane_net.bridge %}
  {{ iface.name }}:
    match:
      macaddress: '{{ iface.mac }}'
    set-name: {{ iface.name }}
    addresses:
      - {{ machine.openstack.ctlplane_ip }}/24
    routes:
      - to: default
        via: {{ ctlplane_net.ipv4.address }}
{% endfor %}
{% endif %}
