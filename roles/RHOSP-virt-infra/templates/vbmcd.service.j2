[Install]
WantedBy = multi-user.target

[Service]
BlockIOAccounting = True
CPUAccounting = True
ExecReload = /bin/kill -HUP $MAINPID
ExecStart = {{ vbmcd_path }} --foreground
Group = root
MemoryAccounting = True
PrivateDevices = False
PrivateNetwork = False
PrivateTmp = False
PrivateUsers = False
Restart = on-failure
RestartSec = 2
Slice = vbmc.slice
TasksAccounting = True
TimeoutSec = 120
Type = simple
User = root

[Unit]
{% if ansible_distribution_major_version | int >= 10 %}
After = virtqemud.service
{% else %}
After = libvirtd.service
{% endif %}
After = syslog.target
After = network.target
Description = vbmc service
